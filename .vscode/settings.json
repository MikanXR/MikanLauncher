{
  // rust-analyzer checks with clippy so the editor's diagnostics are the gate's,
  // and Rust formats on save through rust-analyzer, which runs rustfmt with the
  // repo's rustfmt.toml.
  "rust-analyzer.check.command": "clippy",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  }
}
